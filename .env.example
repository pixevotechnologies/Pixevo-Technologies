# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Client-side configuration
VITE_API_URL=""
VITE_APP_NAME="Pixevo Technologies"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL CONFIGURATION (Optional - for direct SMTP, Resend, or EmailJS forwarding to team inbox)
# Destination inbox for incoming client inquiries:
CONTACT_RECEIVER_EMAIL="pixevotechnologies@gmail.com"

# SMTP Settings (e.g., Gmail App Password, SendGrid, Mailgun, Amazon SES):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""

# Resend API Key (optional alternate provider):
RESEND_API_KEY=""

# EmailJS Service Credentials (optional client/server provider):
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
